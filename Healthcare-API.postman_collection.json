    {
      "name": "TC06 Delete patient with invalid or missing patientId",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const patientId = pm.environment.get(\"patientId\");",
              "const invalidPatientId = patientId && String(patientId).trim()",
              "    ? `${String(patientId).trim()}-invalid`",
              "    : \"missing-patient-id\";",
              "",
              "pm.variables.set(\"invalidPatientId\", invalidPatientId);",
              "console.log(\"Invalid patient ID being used:\", invalidPatientId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or in the 400-499 range\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403, 404, 405, 409]);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test(\"Response is an OperationOutcome\", function () {",
              "    pm.expect(response.resourceType).to.eql(\"OperationOutcome\");",
              "});",
              "",
              "pm.test(\"OperationOutcome contains issues\", function () {",
              "    pm.expect(response.issue).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "pm.test(\"First issue contains required details\", function () {",
              "    const issue = response.issue[0];",
              "",
              "    pm.expect(issue.severity).to.be.a(\"string\");",
              "    pm.expect(",
              "        typeof issue.code === \"string\" || typeof issue.diagnostics === \"string\"",
              "    ).to.be.true;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/Patient/{{invalidPatientId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "Patient",
            "{{invalidPatientId}}"
          ]
        },
        "description": "Generated from cURL: curl --request DELETE --url '{{base_url}}/Patient/{{invalidPatientId}}'"
      },
      "response": []
    },
    {
      "name": "TC07 Create invalid data",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Request is rejected with HTTP 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Response resource type is OperationOutcome\", function () {",
              "    pm.expect(response.resourceType).to.eql(\"OperationOutcome\");",
              "});",
              "",
              "pm.test(\"OperationOutcome contains processing error\", function () {",
              "    pm.expect(response.issue).to.be.an(\"array\").that.is.not.empty;",
              "    const matchingIssue = response.issue.some(issue =>",
              "        issue.code === \"processing\" && issue.severity === \"error\"",
              "    );",
              "    pm.expect(matchingIssue, \"expected issue code=processing and severity=error\").to.be.true;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
