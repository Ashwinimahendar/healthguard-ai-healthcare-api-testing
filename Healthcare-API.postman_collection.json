          "raw": "{\r\n  \"resourceType\": \"Patient\",\r\n  \"id\": \"{{patientId}}\",\r\n  \"name\": [\r\n    {\r\n      \"family\": \"{{lastName}}-Updated\",\r\n      \"given\": [\r\n        \"{{firstName}}\"\r\n      ]\r\n    }\r\n  ],\r\n  \"gender\": \"{{gender}}\",\r\n  \"birthDate\": \"{{birthDate}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/Patient/{{patientId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "Patient",
            "{{patientId}}"
          ]
        }
      },
      "response": []
